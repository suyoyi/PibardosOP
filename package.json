{
  "name": "pibardos-op",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "node scripts/start-database.mjs",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:types": "node scripts/generate-types.mjs",
    "setup:local": "node scripts/configure-local.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src scripts tests docs *.md *.ts *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests docs *.md *.ts *.mjs *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "type": "module"
}
