# Browser-safe project URL and publishable key (legacy anon key is also supported).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Optional legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Do not put a service-role key in any NEXT_PUBLIC_* variable.
# No service-role key is used by this application.
# OPTCG API needs no credential. Optional public-response cache duration in seconds.
# OPTCG_CACHE_SECONDS=3600
